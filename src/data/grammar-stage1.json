{
  "stage": 1,
  "units": [
    {
      "id": "g1-1", "stage": 1, "no": 1, "title": "be 动词（am / is / are）",
      "knowledge": "be 动词随主语变化：I 用 am；he / she / it 用 is；we / you / they 用 are。例：I am a student. She is a teacher. They are friends.",
      "questions": [
        { "q": "I ___ a student.", "options": ["am", "is", "are", "be"], "answer": 0 },
        { "q": "She ___ my sister.", "options": ["am", "is", "are", "be"], "answer": 1 },
        { "q": "They ___ good friends.", "options": ["am", "is", "are", "be"], "answer": 2 },
        { "q": "It ___ a cute cat.", "options": ["am", "is", "are", "be"], "answer": 1 },
        { "q": "We ___ in the classroom.", "options": ["am", "is", "are", "be"], "answer": 2 },
        { "q": "He ___ my father.", "options": ["am", "is", "are", "be"], "answer": 1 },
        { "q": "You ___ very kind.", "options": ["am", "is", "are", "be"], "answer": 2 },
        { "q": "Tom and Jerry ___ funny.", "options": ["am", "is", "are", "be"], "answer": 2 }
      ]
    },
    {
      "id": "g1-2", "stage": 1, "no": 2, "title": "名词复数",
      "knowledge": "多数名词加 -s（books）；以 s/x/ch/sh 结尾加 -es（boxes）；辅音字母+y 结尾变 y 为 i 加 -es（cities）；少数不规则（man→men，child→children，foot→feet）。",
      "questions": [
        { "q": "one apple → two ___", "options": ["apple", "apples", "appleses", "applys"], "answer": 1 },
        { "q": "one box → two ___", "options": ["boxs", "boxes", "boxies", "box"], "answer": 1 },
        { "q": "one city → two ___", "options": ["citys", "cityes", "cities", "city"], "answer": 2 },
        { "q": "one man → two ___", "options": ["mans", "manes", "man", "men"], "answer": 3 },
        { "q": "one child → three ___", "options": ["childs", "childes", "children", "childrens"], "answer": 2 },
        { "q": "one bus → two ___", "options": ["buss", "buses", "busies", "bus"], "answer": 1 },
        { "q": "one foot → two ___", "options": ["foots", "footes", "feets", "feet"], "answer": 3 },
        { "q": "one day → many ___", "options": ["dayes", "days", "daies", "day"], "answer": 1 }
      ]
    },
    {
      "id": "g1-3", "stage": 1, "no": 3, "title": "人称代词与物主代词",
      "knowledge": "主格作主语：I / you / he / she / it / we / they。形容词性物主代词后接名词：my / your / his / her / its / our / their。例：This is my book. Her name is Lily.",
      "questions": [
        { "q": "This is ___ book.（我的）", "options": ["I", "me", "my", "mine"], "answer": 2 },
        { "q": "___ name is Lily.（她的）", "options": ["She", "Her", "Hers", "She's"], "answer": 1 },
        { "q": "___ are students.（我们）", "options": ["We", "Our", "Us", "Ours"], "answer": 0 },
        { "q": "That is ___ dog.（他的）", "options": ["he", "him", "his", "he's"], "answer": 2 },
        { "q": "___ like playing football.（他们）", "options": ["Their", "Them", "Theirs", "They"], "answer": 3 },
        { "q": "This is ___ classroom.（我们的）", "options": ["we", "us", "our", "ours"], "answer": 2 },
        { "q": "The cat is washing ___ face.（它的）", "options": ["it", "it's", "its", "itself"], "answer": 2 },
        { "q": "___ am very happy.（我）", "options": ["My", "Me", "Mine", "I"], "answer": 3 }
      ]
    },
    {
      "id": "g1-4", "stage": 1, "no": 4, "title": "一般现在时（含三单）",
      "knowledge": "表示习惯性、经常性的动作或客观事实。主语是第三人称单数（he/she/it/单数名词）时，动词加 -s 或 -es。例：She plays the piano every day. Water boils at 100°C.",
      "questions": [
        { "q": "He ___ to school by bus every morning.", "options": ["go", "goes", "going", "gone"], "answer": 1 },
        { "q": "They ___ football after school.", "options": ["play", "plays", "playing", "played"], "answer": 0 },
        { "q": "My mother ___ TV in the evening.", "options": ["watch", "watchs", "watches", "watching"], "answer": 2 },
        { "q": "I ___ breakfast at seven.", "options": ["have", "has", "having", "haves"], "answer": 0 },
        { "q": "Tom ___ his homework every day.", "options": ["do", "dos", "does", "doing"], "answer": 2 },
        { "q": "The sun ___ in the east.", "options": ["rise", "rises", "rising", "rose"], "answer": 1 },
        { "q": "We ___ English every morning.", "options": ["reads", "read", "reading", "reades"], "answer": 1 },
        { "q": "She ___ ice cream very much.", "options": ["like", "likes", "liking", "likes to"], "answer": 1 }
      ]
    },
    {
      "id": "g1-5", "stage": 1, "no": 5, "title": "一般疑问句与否定句",
      "knowledge": "一般现在时变疑问句：主语非三单用 Do 开头，三单用 Does 开头（动词还原）。否定句：don't / doesn't + 动词原形。例：Do you like tea? She doesn't like coffee.",
      "questions": [
        { "q": "___ you like music?", "options": ["Do", "Does", "Is", "Are"], "answer": 0 },
        { "q": "___ he play basketball?", "options": ["Do", "Does", "Is", "Are"], "answer": 1 },
        { "q": "She ___ like coffee.", "options": ["don't", "doesn't", "isn't", "aren't"], "answer": 1 },
        { "q": "I ___ know the answer.", "options": ["doesn't", "isn't", "don't", "not"], "answer": 2 },
        { "q": "___ they live in Beijing?", "options": ["Do", "Does", "Is", "Are"], "answer": 0 },
        { "q": "Does she ___ English every day?", "options": ["studies", "study", "studying", "studied"], "answer": 1 },
        { "q": "They ___ go to work by car.", "options": ["doesn't", "isn't", "aren't", "don't"], "answer": 3 },
        { "q": "___ your father work in a hospital?", "options": ["Do", "Does", "Is", "Are"], "answer": 1 }
      ]
    },
    {
      "id": "g1-6", "stage": 1, "no": 6, "title": "there be 句型",
      "knowledge": "there be 表示「某处有某物」：单数/不可数名词用 there is，复数用 there are。就近原则：be 动词与最近的名词保持一致。例：There is a book on the desk. There are two cats under the tree.",
      "questions": [
        { "q": "There ___ a book on the desk.", "options": ["is", "are", "be", "am"], "answer": 0 },
        { "q": "There ___ two cats under the tree.", "options": ["is", "are", "be", "am"], "answer": 1 },
        { "q": "There ___ some milk in the cup.", "options": ["is", "are", "be", "am"], "answer": 0 },
        { "q": "There ___ a pen and two pencils in the box.", "options": ["is", "are", "be", "am"], "answer": 0 },
        { "q": "There ___ many students in the classroom.", "options": ["is", "are", "be", "am"], "answer": 1 },
        { "q": "___ there any water in the bottle?", "options": ["Is", "Are", "Do", "Does"], "answer": 0 },
        { "q": "___ there any apples on the table?", "options": ["Is", "Are", "Do", "Does"], "answer": 1 },
        { "q": "There ___ an old tree in front of the house.", "options": ["is", "are", "be", "am"], "answer": 0 }
      ]
    },
    {
      "id": "g1-7", "stage": 1, "no": 7, "title": "形容词与副词基础",
      "knowledge": "形容词修饰名词，放在名词前或 be 动词后（a beautiful girl / She is beautiful）。副词修饰动词，常以 -ly 结尾，表示动作的方式（He runs fast. She sings well.）。",
      "questions": [
        { "q": "She is a ___ girl.", "options": ["beauty", "beautiful", "beautifully", "beauties"], "answer": 1 },
        { "q": "He runs very ___.", "options": ["quick", "quickly", "quicker", "quickness"], "answer": 1 },
        { "q": "This song sounds ___.", "options": ["beautiful", "beautifully", "beauty", "beautify"], "answer": 0 },
        { "q": "She sings ___ in the concert.", "options": ["good", "well", "nice", "wonderful"], "answer": 1 },
        { "q": "The weather is ___ today.", "options": ["nicely", "nice", "niceness", "nicer"], "answer": 1 },
        { "q": "Please speak ___ in the library.", "options": ["quiet", "quietly", "quieter", "quietness"], "answer": 1 },
        { "q": "It is an ___ story.", "options": ["interestingly", "interest", "interesting", "interested"], "answer": 2 },
        { "q": "He is a ___ driver.", "options": ["careful", "carefully", "care", "carefulness"], "answer": 0 }
      ]
    },
    {
      "id": "g1-8", "stage": 1, "no": 8, "title": "冠词（a / an / the）",
      "knowledge": "泛指单数名词用 a（辅音音素前）或 an（元音音素前）；特指或上文提过的人/物用 the。例：an apple, a book, the sun, the Great Wall.",
      "questions": [
        { "q": "I have ___ apple.", "options": ["a", "an", "the", "不填"], "answer": 1 },
        { "q": "He is ___ honest boy.", "options": ["a", "an", "the", "不填"], "answer": 1 },
        { "q": "___ sun rises in the east.", "options": ["A", "An", "The", "不填"], "answer": 2 },
        { "q": "She has ___ useful book.", "options": ["a", "an", "the", "不填"], "answer": 0 },
        { "q": "I play ___ football after school.", "options": ["a", "an", "the", "不填"], "answer": 3 },
        { "q": "He is ___ tallest boy in our class.", "options": ["a", "an", "the", "不填"], "answer": 2 },
        { "q": "There is ___ hour left.", "options": ["a", "an", "the", "不填"], "answer": 1 },
        { "q": "___ Great Wall is very famous.", "options": ["A", "An", "The", "不填"], "answer": 2 }
      ]
    },
    {
      "id": "g1-9", "stage": 1, "no": 9, "title": "祈使句",
      "knowledge": "祈使句表示命令、请求或建议：动词原形开头（Sit down!）；否定用 Don't + 动词原形（Don't run!）；建议用 Let's + 动词原形（Let's go!）。",
      "questions": [
        { "q": "___ down, please.", "options": ["Sit", "Sits", "Sitting", "To sit"], "answer": 0 },
        { "q": "___ run in the classroom!", "options": ["Not", "No", "Don't", "Doesn't"], "answer": 2 },
        { "q": "___ go to the park together.", "options": ["Let", "Let's", "Lets", "We let"], "answer": 1 },
        { "q": "___ your homework first.", "options": ["Do", "Does", "Doing", "To do"], "answer": 0 },
        { "q": "___ late for school again!", "options": ["Don't be", "Not be", "No be", "Doesn't be"], "answer": 0 },
        { "q": "___ the door, please.", "options": ["Open", "Opens", "Opening", "To open"], "answer": 0 },
        { "q": "___ quiet in the library.", "options": ["Being", "Be", "To be", "Been"], "answer": 1 },
        { "q": "Let's ___ basketball after class.", "options": ["plays", "playing", "play", "played"], "answer": 2 }
      ]
    },
    {
      "id": "g1-10", "stage": 1, "no": 10, "title": "基础介词（in / on / at / under）",
      "knowledge": "in 在…里面（in the box）；on 在…上面（on the desk）；at 在（小地点/时间点）（at school, at 8 o'clock）；under 在…下面（under the tree）。",
      "questions": [
        { "q": "The book is ___ the desk.", "options": ["in", "on", "at", "of"], "answer": 1 },
        { "q": "The cat is ___ the box.", "options": ["on", "at", "in", "with"], "answer": 2 },
        { "q": "He gets up ___ six o'clock.", "options": ["in", "on", "at", "under"], "answer": 2 },
        { "q": "The ball is ___ the bed.", "options": ["on", "in", "at", "under"], "answer": 3 },
        { "q": "We have lunch ___ noon.", "options": ["in", "on", "at", "under"], "answer": 2 },
        { "q": "There is a picture ___ the wall.", "options": ["in", "on", "at", "under"], "answer": 1 },
        { "q": "She is ___ school now.", "options": ["in", "on", "at", "under"], "answer": 2 },
        { "q": "My keys are ___ my pocket.", "options": ["on", "in", "at", "under"], "answer": 1 }
      ]
    }
  ]
}
